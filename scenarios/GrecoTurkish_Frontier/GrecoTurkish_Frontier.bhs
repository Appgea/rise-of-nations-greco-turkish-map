int p;
int c;
int n;
int i;
int j;
int best;
int bestd;
int d;
int dx;
int dy;
int cid;
int cx;
int cy;
int found;
int freeslot;
int wx;
int off;
int x1;
int y1;
int x2;
int y2;
String cname;
String newname;

run_once {
  wx = world_x_size();
  off = 6 * wx / 512;
  if (off < 1) {
    off = 1;
  }
  x1 = 134 * wx / 512;
  y1 = 250 * wx / 512;
  x2 = 330 * wx / 512;
  y2 = 270 * wx / 512;

  create_building_near(1, x1, y1, "Small City", 1 * wx / 512);
  if (num_cities(1) == 0) {
    create_building_near(1, x1, y1, "Small City", 5 * wx / 512);
  }
  if (num_cities(1) == 0) {
    create_building_near(1, x1, y1, "Small City", 10 * wx / 512);
  }
  create_unit(1, x1 + off, y1 + off, "Citizen", 5);
  create_unit(1, x1 + off, y1 + off, "Scout", 1);

  create_building_near(2, x2, y2, "Small City", 1 * wx / 512);
  if (num_cities(2) == 0) {
    create_building_near(2, x2, y2, "Small City", 5 * wx / 512);
  }
  if (num_cities(2) == 0) {
    create_building_near(2, x2, y2, "Small City", 10 * wx / 512);
  }
  create_unit(2, x2 + off, y2 + off, "Citizen", 5);
  create_unit(2, x2 + off, y2 + off, "Scout", 1);

  declare_war(1, 2);
  declare_war(2, 1);

  set_timer("names", 1);
  set_timer("endcheck", 30);
  setup_done = 1;

  popup_dialog("Greco-Turkish War on a real map of the Aegean, Anatolia and the Balkans. Every city you found takes the real name of the nearest place, in your own language; captured cities are renamed by their new owner. Take all enemy cities to win.");
}

trigger NameCities(timer_expired("names"))
{
  wx = world_x_size();
  for (p = 1; p < 3; p++) {
    n = num_cities(p);
    for (c = 0; c <= n; c++) {
      cname = find_city_with_num(p, c);
      if (!(cname == "")) {
        found = -1;
        for (j = 0; j < kmax; j++) {
          if (k_owner[j] > 0) {
            if (k_name[j] == cname) {
              found = j;
              break;
            }
          }
        }
        if (found == -1) {
          cid = find_city_id(cname);
          cx = object_position_x(p, cid) * 512 / wx;
          cy = object_position_y(p, cid) * 512 / wx;
          best = -1;
          bestd = 999999999;
          for (i = 0; i < nslot; i++) {
            if (slot_used[i] == 0) {
              dx = slot_x[i] - cx;
              dy = slot_y[i] - cy;
              d = dx * dx + dy * dy - slot_pull[i];
              if (d < bestd) {
                bestd = d;
                best = i;
              }
            }
          }
          freeslot = -1;
          for (j = 0; j < kmax; j++) {
            if (k_owner[j] == 0) {
              freeslot = j;
              break;
            }
          }
          if (cap_done[p] == 0) {
            if (cap_slot[p] >= 0) {
              best = cap_slot[p];
            }
            cap_done[p] = 1;
          }
          if (best >= 0 && freeslot >= 0) {
            if (p == 1) {
              newname = gr_name[best];
            }
            else {
              newname = tr_name[best];
            }
            rename_city(p, cid, newname);
            slot_used[best] = 1;
            k_name[freeslot] = newname;
            k_owner[freeslot] = p;
            k_slot[freeslot] = best;
          }
        }
        else if (k_owner[found] != p) {
          cid = find_city_id(cname);
          if (p == 1) {
            newname = gr_name[k_slot[found]];
          }
          else {
            newname = tr_name[k_slot[found]];
          }
          if (!(newname == cname)) {
            rename_city(p, cid, newname);
          }
          k_name[found] = newname;
          k_owner[found] = p;
        }
      }
    }
  }
  for (j = 0; j < kmax; j++) {
    if (k_owner[j] > 0) {
      if (!city_exists(k_name[j])) {
        slot_used[k_slot[j]] = 0;
        k_owner[j] = 0;
        k_name[j] = "";
      }
    }
  }
  set_timer("names", 2);
  enable_trigger("NameCities");
}

trigger CheckEnd(timer_expired("endcheck"))
{
  if (num_cities(1) == 0) {
    victory(2);
    defeat(1);
  }
  else if (num_cities(2) == 0) {
    victory(1);
    defeat(2);
  }
  else {
    set_timer("endcheck", 5);
    enable_trigger("CheckEnd");
  }
}

}
